#!/usr/bin/env sh
set -eu

HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GATE="$HOOK_DIR/contribution_gate.py"

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "Contribution gate: Python is required." >&2
  exit 1
fi

"$PYTHON" "$GATE" status
